# BountyStrike v5 — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.

# Core infra
POSTGRES_PASSWORD=
REDIS_PASSWORD=
HATCHET_COOKIE_SECRET=
LANGFUSE_SECRET=
LANGFUSE_SALT=

# LLM providers
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Bug bounty platform auth
H1_API_TOKEN=
H1_USERNAME=
BUGCROWD_SESSION_COOKIE=
INTIGRITI_PAT=
YESWEHACK_BEARER=

# Scope JWT signing
SCOPE_JWT_PRIVATE_KEY_PATH=keys/scope_jwt_private.pem
SCOPE_JWT_PUBLIC_KEY_PATH=keys/scope_jwt_public.pem

# Cloudflare R2 evidence store
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# OAST callback infra
INTERACTSH_SERVER_URL=
INTERACTSH_AUTH=
BURP_COLLABORATOR_URL=
