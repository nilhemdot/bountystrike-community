# BountyStrike v5 — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.

# Core infra
POSTGRES_PASSWORD=
REDIS_PASSWORD=
HATCHET_COOKIE_SECRET=
LANGFUSE_SECRET=
LANGFUSE_SALT=

# Redis connection (consumed by kill switch + cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Kill switch (build-plan §6.6 Layer 1)
# KILL_SWITCH_BACKEND=redis (default, prod) | memory (tests/dev)
# KILL_SWITCH_KEY defaults to bountystrike:killswitch:global
KILL_SWITCH_BACKEND=redis
KILL_SWITCH_KEY=bountystrike:killswitch:global

# LLM providers
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Bug bounty platform auth
H1_API_TOKEN=
H1_USERNAME=
BUGCROWD_SESSION_COOKIE=
INTIGRITI_PAT=
YESWEHACK_BEARER=

# Scope JWT signing
SCOPE_JWT_PRIVATE_KEY_PATH=keys/scope_jwt_private.pem
SCOPE_JWT_PUBLIC_KEY_PATH=keys/scope_jwt_public.pem

# Evidence store backend
# EVIDENCE_BACKEND=local (default) → filesystem store under EVIDENCE_ROOT
# EVIDENCE_BACKEND=r2              → Cloudflare R2 (requires R2_* vars below)
EVIDENCE_BACKEND=local
EVIDENCE_ROOT=./evidence

# Cloudflare R2 evidence store (used when EVIDENCE_BACKEND=r2)
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: override the derived endpoint (else https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
R2_ENDPOINT_URL=
# Optional: S3 region — R2 ignores it but boto3 requires *something*
R2_REGION=auto

# OAST callback infra
INTERACTSH_SERVER_URL=
INTERACTSH_AUTH=
BURP_COLLABORATOR_URL=
