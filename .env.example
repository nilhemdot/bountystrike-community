# BountyStrike v5 — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.

# ============================================================================
# BYOK (Bring Your Own Key) — Solo Mode Philosophy
# ============================================================================
# BountyStrike v5 is designed for BYOK API access. You control your keys,
# your spend, and your data. No middleman, no markup, no vendor lock-in.
#
# Solo mode targets <$30/month infra cost — bounty payouts are your income.
# The platform itself should cost less than a streaming subscription.
#
# Recommended for solo operators:
#   • Anthropic Claude (1M requests/month FREE tier) — best reasoning
#   • DeepSeek V4-Flash (primary, $0.27/M tokens) — best $/quality
#   • OpenRouter (fallback, pay-as-you-go) — multi-model flexibility
#
# All API keys below are BYOK. Sign up directly with providers.
# ============================================================================

# ============================================================================
# LLM Providers (BYOK Required)
# ============================================================================
# Anthropic Claude — recommended for exploit validation + report writing
# Solo mode: use 1M req/month free tier (Sonnet 4.6, Opus 4.7)
# Get your key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# DeepSeek — recommended PRIMARY model for solo mode (cheapest, fast)
# V4-Flash: $0.27/M input, $1.10/M output — 10x cheaper than GPT-4
# Get your key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenRouter — fallback/multi-model router (optional but recommended)
# Unified API for 200+ models; pay only for what you use
# Get your key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# xAI Grok — optional, good for creative recon (if you have access)
# Get your key: https://console.x.ai/
XAI_API_KEY=

# OpenAI — optional, generally not recommended for solo (expensive)
# Only needed if you want GPT-4 for specific tasks
OPENAI_API_KEY=

# LiteLLM Router Config (optional — for advanced model routing)
# If set, overrides direct provider keys with a central routing proxy
# Useful for: token budgets, fallbacks, cost tracking, A/B testing
# LITELLM_PROXY_URL=http://localhost:4000
# LITELLM_API_KEY=

# ============================================================================
# Core Infrastructure (Required)
# ============================================================================
# Generate secure secrets via: openssl rand -base64 32

POSTGRES_PASSWORD=
REDIS_PASSWORD=
HATCHET_COOKIE_SECRET=
HATCHET_POSTGRES_PASSWORD=
LANGFUSE_SECRET=
LANGFUSE_SALT=

# Redis connection (consumed by kill switch + cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Kill switch (build-plan §6.6 Layer 1)
# KILL_SWITCH_BACKEND=redis (default, prod) | memory (tests/dev)
# KILL_SWITCH_KEY defaults to bountystrike:killswitch:global
KILL_SWITCH_BACKEND=redis
KILL_SWITCH_KEY=bountystrike:killswitch:global

# ============================================================================
# Bug Bounty Platform Authentication (BYOK Required)
# ============================================================================
# BountyStrike never stores or proxies your platform credentials.
# You authenticate directly with each platform using your own API tokens.
#
# HackerOne — API token + username for scope/program/submission access
# Get token: https://hackerone.com/settings/api_token/edit
H1_API_TOKEN=
H1_USERNAME=

# Bugcrowd — session cookie (refresh monthly when it expires)
# Extract from browser: DevTools → Application → Cookies → _bugcrowd_session
BUGCROWD_SESSION_COOKIE=

# Intigriti — personal access token (PAT)
# Get token: https://app.intigriti.com/researcher/profile/api-token
INTIGRITI_PAT=

# YesWeHack — bearer token for API access
# Get token: https://yeswehack.com/user/settings/api
YESWEHACK_BEARER=

# Scope JWT signing
SCOPE_JWT_PRIVATE_KEY_PATH=keys/scope_jwt_private.pem
SCOPE_JWT_PUBLIC_KEY_PATH=keys/scope_jwt_public.pem

# Evidence store backend
# EVIDENCE_BACKEND=local (default) → filesystem store under EVIDENCE_ROOT
# EVIDENCE_BACKEND=r2              → Cloudflare R2 (requires R2_* vars below)
EVIDENCE_BACKEND=local
EVIDENCE_ROOT=./evidence

# Cloudflare R2 evidence store (used when EVIDENCE_BACKEND=r2)
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: override the derived endpoint (else https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
R2_ENDPOINT_URL=
# Optional: S3 region — R2 ignores it but boto3 requires *something*
R2_REGION=auto

# ============================================================================
# OAST (Out-of-Band Application Security Testing) Callbacks
# ============================================================================
# Used for blind XSS, SSRF, XXE detection — callbacks prove exploitation
#
# Interactsh — free public server (oast.pro) or self-hosted
# Public server: https://oast.pro (no auth needed for basic use)
# Self-hosted: https://github.com/projectdiscovery/interactsh
INTERACTSH_SERVER_URL=https://oast.pro
INTERACTSH_AUTH=

# Burp Collaborator — optional, requires Burp Suite Pro license
# Only needed if you already have Burp Pro and want to use its callbacks
BURP_COLLABORATOR_URL=

# ============================================================================
# BYOK Cost Transparency (Solo Mode Typical Monthly Spend)
# ============================================================================
# Infrastructure:
#   • Docker (local Postgres, Redis, Hatchet, Langfuse) — $0/month
#   • Cloudflare R2 storage (10GB, 1M Class-B ops) — ~$1-3/month
#   • Caddy + ngrok/Cloudflare Tunnel (HTTPS) — $0-5/month
#   • VPS if needed (optional, for always-on) — $0-10/month (Hetzner/OVH)
#
# LLM API (BYOK, your usage):
#   • Anthropic Claude free tier — 1M req/month, $0/month for light use
#   • DeepSeek V4-Flash primary — ~$5-15/month for heavy scanning
#   • OpenRouter fallback — pay only what you use, ~$2-10/month
#
# External tool APIs (optional):
#   • Shodan — $59/month (optional, only if doing IoT/network recon)
#   • SecurityTrails — $99/month (optional, only if doing deep DNS intel)
#   • VirusTotal — free tier adequate for most solo use
#
# Target: <$30/month all-in. No SaaS markup, no seat licenses, no surprises.
# Your bounty payouts are the business model, not subscription fees.
# ============================================================================
