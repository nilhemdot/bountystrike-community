# syntax=docker/dockerfile:1.7
#
# BountyStrike v5 — control-plane FastAPI orchestrator runtime container.
#
# Single-stage build: slim Python image with control-plane source and all
# dependencies installed via uv (project package manager).
#
# Per control-plane/pyproject.toml the control-plane is a FastAPI orchestrator
# with workers that coordinate scan jobs, triage, reporting, and MCP servers.
#
# Build (from repo root):
#   docker build -f infra/docker/Dockerfile.control-plane -t bs-control-plane:dev .
#
# Run (orchestrator — docker-compose wires the env):
#   docker run --rm \
#     -e DATABASE_URL=postgresql://... -e REDIS_URL=redis://... \
#     -e ANTHROPIC_API_KEY=... -e JWT_PUBLIC_KEY=... \
#     -p 8000:8000 \
#     bs-control-plane:dev

# ============================================================================
# Runtime: slim Python with control-plane FastAPI service.
# ============================================================================
FROM python:3.12-slim AS runtime

# uv is the project's package manager (per pyproject + uv.lock at root).
# Copying the official static binary keeps the image small.
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv

# Runtime deps: ca-certs for HTTPS to external APIs (HackerOne, BugCrowd,
# Anthropic), tini for PID-1 signal handling so `docker stop` reaches the
# FastAPI process cleanly when orchestrator-level shutdown fires.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

# Non-root user — control-plane has no business writing outside its working
# directory and the orchestrator mounts state via env, not a volume.
# uid pinned to 1000 so the uv cache mount (below) can declare the same
# uid/gid and stay writable after `USER controlplane`.
RUN useradd --create-home --shell /usr/sbin/nologin --uid 1000 controlplane
USER controlplane
WORKDIR /home/controlplane/app

# Pre-compile bytecode at install time so the first `import` after
# container start doesn't pay the JIT-compile cost per module.
# UV_LINK_MODE=copy avoids hardlink warnings when the cache mount lives
# on a different filesystem than the venv.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# --- Layer A: dep-manifest-only copy + sync ---
# The third-party dep set rarely changes; copying just the lock + the
# pyproject manifests (without source) lets Docker cache the heavy
# `uv sync` step across iterations where only Python source moves.
# `--no-install-workspace` skips the local workspace members
# (control-plane, mcp/*) — they're installed in Layer B once their
# source is present.
#
# Cache mount on uv's wheel cache persists across rebuilds — even when
# uv.lock changes invalidate this layer, wheel downloads stay cached.
COPY --chown=controlplane:controlplane uv.lock pyproject.toml /home/controlplane/app/
COPY --chown=controlplane:controlplane control-plane/pyproject.toml /home/controlplane/app/control-plane/pyproject.toml
RUN --mount=type=cache,target=/home/controlplane/.cache/uv,uid=1000,gid=1000 \
    cd /home/controlplane/app/control-plane && \
    uv sync --frozen --no-dev --no-install-workspace

# --- Layer B: full control-plane source + workspace install ---
# Source COPY invalidates only this layer + below on .py edits;
# Layer A's third-party install stays cached. The second `uv sync`
# only needs to (re-)editable-install the local workspace member,
# which is fast because every wheel it would otherwise re-download
# is already in Layer A's `.venv`.
COPY --chown=controlplane:controlplane control-plane /home/controlplane/app/control-plane
RUN --mount=type=cache,target=/home/controlplane/.cache/uv,uid=1000,gid=1000 \
    cd /home/controlplane/app/control-plane && uv sync --frozen --no-dev

# Sanity check: the control_plane module must be importable in the final image.
RUN cd control-plane && uv run python -c \
    "import control_plane; \
     print('control-plane module OK')"

# Expose FastAPI default port (uvicorn serves on 8000 by default).
EXPOSE 8000

# Tini owns PID 1; the python/uvicorn entrypoint is specified at runtime
# by docker-compose CMD override. This allows flexibility for different
# startup modes (FastAPI server, worker, migration runner, etc).
# Default: sleep infinity (allows exec into container for debugging).
# Override in docker-compose with:
#   command: ["uvicorn", "control_plane.app:app", "--host", "0.0.0.0", "--port", "8000"]
ENTRYPOINT ["/usr/bin/tini", "--", "uv", "run", "--directory", "control-plane"]
CMD ["python", "-c", "import time; print('control-plane container ready (override CMD to start service)'); time.sleep(infinity)"]
