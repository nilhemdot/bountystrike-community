# syntax=docker/dockerfile:1.7
#
# BountyStrike v5 — recon-agent runtime container.
#
# Stage 1 ("toolchain") builds pinned ProjectDiscovery binaries from
# source; Stage 2 ("runtime") is a slim Python image with the binaries
# copied in and control-plane source layered on top.
#
# Per .claude/agents/recon.md the recon-agent shells out to:
#   subfinder  v2.6.6   passive subdomain enum + active DNS brute
#   httpx      v1.6.9   HTTP probe + tech fingerprint
#   katana     v1.1.2   endpoint crawler with form extraction
#
# Build (from repo root):
#   docker build -f infra/docker/Dockerfile.recon -t bs-recon:dev .
#
# Run (one-shot — orchestrator wires the env):
#   docker run --rm \
#     -e SCOPE_JWT=... -e PROGRAM_HANDLE=acme -e PLATFORM=hackerone \
#     -e DATABASE_URL=postgresql://... -e SCAN_JOB_ID=$(uuidgen) \
#     bs-recon:dev

# ============================================================================
# Stage 1 — toolchain: build pinned PD binaries from upstream tags.
# ============================================================================
FROM golang:1.23-alpine AS toolchain

# git is needed by `go install` to clone tagged source.
# gcc + musl-dev are only needed for katana (see below) — included
# unconditionally because the layer cost is negligible.
RUN apk add --no-cache git gcc musl-dev

ENV GOBIN=/out \
    GOFLAGS="-trimpath"

RUN mkdir -p /out

# Pinned versions match `.claude/agents/recon.md`. Bumping any of these is
# a deliberate, reviewed change — never floating tags.
#
# subfinder + httpx don't need cgo. CGO_ENABLED=0 produces fully static
# Go binaries (Go's pure-Go net resolver replaces libc), which the
# glibc-based runtime stage can consume without libc shims.
RUN CGO_ENABLED=0 go install github.com/projectdiscovery/subfinder/v2/cmd/subfinder@v2.6.6 && \
    CGO_ENABLED=0 go install github.com/projectdiscovery/httpx/cmd/httpx@v1.6.9

# katana@v1.1.2 transitively pulls `smacker/go-tree-sitter`, a cgo
# wrapper around libtree-sitter — with CGO_ENABLED=0 the cgo-tagged
# source files get excluded by build constraints and the package fails
# to compile (`undefined: Node`). We therefore build katana with cgo
# enabled, but link statically against musl
# (`-linkmode external -extldflags -static`) so the output binary is
# still copyable into the glibc runtime stage as a self-contained
# executable with no shared-library deps.
RUN CGO_ENABLED=1 go install \
    -ldflags '-linkmode external -extldflags "-static"' \
    github.com/projectdiscovery/katana/cmd/katana@v1.1.2

# Smoke-check inside the build: if any binary is broken we want to know
# now, not at first scan-job dispatch.
#
# We assert BOTH the version string AND the static-link mode. Round 16
# fixed a regression where an upstream cgo dep silently produced a
# dynamically-linked katana binary that passed `-version` but would
# fail at runtime in the glibc runtime stage. The `file` check guards
# against that whole regression class.
RUN apk add --no-cache file && \
    /out/subfinder -version 2>&1 | grep -F "v2.6.6" && \
    /out/httpx     -version 2>&1 | grep -F "v1.6.9" && \
    /out/katana    -version 2>&1 | grep -F "v1.1.2" && \
    file /out/subfinder | grep -q "statically linked" && \
    file /out/httpx     | grep -q "statically linked" && \
    file /out/katana    | grep -q "statically linked"


# ============================================================================
# Stage 2 — runtime: slim Python with PD binaries layered in.
# ============================================================================
FROM python:3.12-slim AS runtime

# uv is the project's package manager (per pyproject + uv.lock at root).
# Copying the official static binary keeps the image small.
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv

# Runtime deps: ca-certs for HTTPS, tini for PID-1 signal handling so
# `docker stop` reaches the Python process cleanly when an
# orchestrator-level kill switch fires.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

# Pull the three Go binaries from the toolchain stage. They are static
# (subfinder + httpx via CGO_ENABLED=0; katana via cgo +
# `-linkmode external -extldflags "-static"` against alpine musl) so
# the slim base needs no libc shims.
COPY --from=toolchain /out/subfinder /usr/local/bin/subfinder
COPY --from=toolchain /out/httpx     /usr/local/bin/httpx
COPY --from=toolchain /out/katana    /usr/local/bin/katana

# Non-root user — recon-agent has no business writing outside its scratch
# directory and the orchestrator mounts state via env, not a volume.
RUN useradd --create-home --shell /usr/sbin/nologin recon
USER recon
WORKDIR /home/recon/app

# Copy control-plane source. The recon harness lives under
# `control_plane.domains.recon` and is consumed via `python -m`.
COPY --chown=recon:recon control-plane /home/recon/app/control-plane
COPY --chown=recon:recon uv.lock pyproject.toml* /home/recon/app/

# Resolve + install python deps. `uv sync --frozen` refuses to update
# uv.lock — fail loud if the lock is out of date instead of silently
# drifting between dev and prod.
RUN cd control-plane && uv sync --frozen --no-dev

# Sanity check: the harness module must be importable in the final image.
RUN cd control-plane && uv run python -c \
    "import control_plane.domains.recon as r; \
     assert hasattr(r, 'ReconService'); \
     print('recon harness OK')"

# Tini owns PID 1; the python entrypoint is the recon CLI module.
ENTRYPOINT ["/usr/bin/tini", "--", "uv", "run", "--directory", "control-plane", \
            "python", "-m", "control_plane.domains.recon"]
